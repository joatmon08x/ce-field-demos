{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/synthetic-prompt.mjs",
        "matcher": "UserPromptSubmit",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/contrast-collect.sh",
        "timeout": 2
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/contrast-check.mjs",
        "loop_limit": 1,
        "timeout": 3
      }
    ]
  }
}
